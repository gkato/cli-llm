# Qwen3.8-27B SGLang / DSpark profile for one dedicated DGX Spark (GB10).
# The raw SGLang listener is forced to loopback; port 8000 is the authenticated proxy.
QUANT=nvfp4
YARN=0
CONTEXT_LENGTH=262144
MAX_CONCURRENT_REQUESTS=10
CHUNKED_PREFILL=8192
CPUSET=5-9,15-19
SERVED_MODEL_NAME=qwen3.8-27b-sglang
SERVING_HOST=127.0.0.1
SERVING_PORT=8888
DSPARK_PROXY_HOST=0.0.0.0
DSPARK_PROXY_PORT=8000
# DSpark is native-context only; YaRN requires SPECULATIVE_MODE=mtp.
SPECULATIVE_MODE=dspark
# Keep request logging on for OpenCode and proxy integration diagnostics.
DSPARK_EXTRA=--log-requests
QWEN38_27B_MIN_AVAILABLE_GIB=100
