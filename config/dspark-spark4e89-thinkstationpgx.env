# DeepSeek V4 Flash 0731 cluster profile for this two-Spark installation.
#
# Head:   northfirst@spark-4e89
# Worker: totalpass@thinkstationpgx-fd9c
#
# scripts/DS4-Flash-DSpark.sh reads this file without executing it. Values may
# still be overridden for one command by exporting the same variable first.

# Cluster and SSH control plane. SSH is deliberately pinned to the first
# dedicated fabric address rather than Wi-Fi or Tailscale.
WORKER_HOST=totalpass@192.168.177.11
WORKER_SCRIPT_DIR=/home/totalpass/deepseek-v4-flash-miaai-runtime
MASTER_ADDR=192.168.177.10
VLLM_HOST_IP=192.168.177.10
WORKER_VLLM_HOST_IP=192.168.177.11
HEAD_FABRIC_IPS=192.168.177.10,192.168.178.10
WORKER_FABRIC_IPS=192.168.177.11,192.168.178.11
MASTER_PORT=29500

# Both connected ConnectX-7 lanes. Each interface is configured for MTU 9000.
NCCL_IB_HCA=rocep1s0f1,roceP2p1s0f1
# Socket/bootstrap traffic uses one deterministic lane; NCCL_IB_HCA carries
# model traffic over both HCAs. FABRIC_IFNAMES keeps preflight dual-lane.
NCCL_SOCKET_IFNAME=enp1s0f1np1
TP_SOCKET_IFNAME=enp1s0f1np1
GLOO_SOCKET_IFNAME=enp1s0f1np1
FABRIC_IFNAMES=enp1s0f1np1,enP2p1s0f1np1
NCCL_IB_MERGE_NICS=1
NCCL_CROSS_NIC=1
NCCL_IB_GID_AUTO=0
NCCL_IB_GID_INDEX=3
WORKER_NCCL_IB_GID_INDEX=3

# Model and caches.
ABLITERATED=0
DSPARK_MODEL_OFFICIAL=deepseek-ai/DeepSeek-V4-Flash-0731
DSPARK_REVISION=9e165c30e2704aec5d9d593cce3eebd58bbef1cb
SERVED_MODEL_NAME=deepseek-v4-flash-0731
HF_CACHE=/home/northfirst/.cache/huggingface
WORKER_HF_CACHE=/home/totalpass/.cache/huggingface
# vLLM is deliberately private. The authenticated allow-list proxy is the only
# network-facing listener and runs on port 8000.
VLLM_HOST=127.0.0.1
VLLM_PORT=8888
DSPARK_PROXY_HOST=0.0.0.0
DSPARK_PROXY_PORT=8000

# MiaAI-Lab's immutable Anemll runtime. The upstream checkout supplies the
# current entrypoint hotfix set; the image and official model weights are pinned.
DSPARK_VLLM_IMAGE=ghcr.io/anemll/dspark-vllm-gx10:0.1.1@sha256:a83948492cf13df455170fb42885f5ef4db54fefe0feff0f841ecbff464ac9d8
IMAGE_PYTHON=/usr/bin/python3
ENABLE_VL_SIDECAR=0
PREPARE_VL_SIDECAR_MODEL=0
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_XET=1

# 512K coding-agent coexistence profile. Launches at 0.70 and asymmetric
# 0.72/0.70 supplied only 2.54 GiB and then 1.23 GiB of the 3.78 GiB KV cache
# required for 512K. Raising each rank by three percentage points from the last
# attempt adds roughly 3.6 GiB of allocation. The worker remains low enough to
# target 24 GiB outside vLLM for the 16 GiB Harness plus 8 GiB OS allowance.
MAX_MODEL_LEN=524288
MAX_NUM_SEQS=4
MAX_NUM_BATCHED_TOKENS=4096
LONG_PREFILL_TOKEN_THRESHOLD=1024
GPU_MEMORY_UTILIZATION_TEXT=0.75
WORKER_GPU_MEMORY_UTILIZATION=0.73
MTP_NUM_TOKENS=5
DEFAULT_THINKING=low
DSPARK_MAX_INFLIGHT_PREFILLS=2
DSPARK_ISSUE43_SCHED_DIAG=0
VLLM_PREFIX_CACHE_RETENTION_INTERVAL=4096
VLLM_USE_BREAKABLE_CUDAGRAPH=0
DSPARK_ENABLE_ISSUE31_GPU_HOTFIX=0
DSPARK_SKIP_HOTFIX=0
DSPARK_SKIP_ISSUE22_HOTFIX=0
DSPARK_SKIP_SPIN_WAIT_HOTFIX=0
DSPARK_SKIP_SUPPRESS_STOPS_HOTFIX=0

# The model must leave this much MemAvailable on totalpass after startup:
# 16 GiB hard ceiling for Harness plus 8 GiB operating headroom.
HARNESS_MEMORY_LIMIT_GIB=16
WORKER_AVAILABLE_TARGET_GIB=24
