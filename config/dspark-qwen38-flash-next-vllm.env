# Qwen3.8 Flash Next NVFP4 with MiaAI's vLLM TP2+EP+MTP3 recipe.
#
# These serving values match MiaAI-Lab's measured 2x DGX Spark profile at
# upstream revision 169fbad. The ml-compute overlay changes only artifact
# pinning, RoCE discovery, lifecycle checks, and API exposure.

# Direct ConnectX-7 RoCE link. Interface/HCA names are compatibility hints;
# the lifecycle resolves the devices owning these IPs on both nodes.
HEAD_CX7_IP=192.168.177.10
WORKER_CX7_IP=192.168.177.11
HEAD_CX7_IF=enp1s0f1np1
WORKER_CX7_IF=enp1s0f1np1
HEAD_CX7_IB=rocep1s0f1
WORKER_CX7_IB=rocep1s0f1
WORKER_USER=totalpass
MASTER_PORT=50000
NCCL_IB_GID_INDEX=3

# Raw vLLM stays private; the shared authenticated proxy is the public API.
HOST_BIND=127.0.0.1
PORT=8888
DSPARK_PROXY_HOST=0.0.0.0
DSPARK_PROXY_PORT=8000

# Immutable model/image pins corresponding to MiaAI's current recipe.
MODEL_ID=RadixArk/Qwen3.8-Flash-Next-NVFP4
MODEL_REVISION=7b719225242aacd3dbd3f9407468c2ee9a9d2594
SERVED_MODEL_NAME=qwen3.8-flash-next
VLLM_IMAGE=vllm/vllm-openai:qwen38-flash-next@sha256:fc120ece0a388cc0aa1caad4a9f1cd92113484ab7ec2fd0efadd62585be05bf8

# MiaAI's measured performance profile. Keep these values together when
# comparing with the upstream numbers: BF16 KV, EP, MTP3, and decode graphs.
TENSOR_PARALLEL_SIZE=2
ENABLE_EXPERT_PARALLEL=true
MTP_NUM_SPECULATIVE_TOKENS=3
MAX_MODEL_LEN=1000000
YARN_ENABLE=true
YARN_FACTOR=4.0
VLLM_ALLOW_LONG_MAX_MODEL_LEN=1
GPU_MEMORY_UTILIZATION=0.835
MAX_NUM_SEQS=8
MAX_NUM_BATCHED_TOKENS=8192
KV_CACHE_DTYPE=auto
PLE_OFFLOAD=false

# Cache and launch operations. HF_HOME defaults below ignored data/dspark/;
# a blank worker path mirrors a head path below $HOME onto the worker's $HOME.
HF_HOME=
WORKER_HF_HOME=
WAIT_TIMEOUT_MIN=90
NCCL_DEBUG=WARN
EXTRA_VLLM_ARGS=
EXTRA_DOCKER_ARGS=

# GB10 unified-memory safeguards. These do not alter MiaAI's vLLM allocation.
QWEN38_VLLM_MIN_AVAILABLE_GIB=108
# MiaAI's 0.835 allocation leaves roughly 7-8 GiB beyond vLLM's budget on a
# 121.69 GiB GB10. Preserve a small control-plane reserve without lowering GMU.
QWEN38_VLLM_MIN_RUNTIME_AVAILABLE_GIB=6
