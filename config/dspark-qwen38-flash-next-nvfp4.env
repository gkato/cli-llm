# Qwen3.8 Flash Next NVFP4 on two linked DGX Sparks (GB10 / SM121).
#
# Consumed by scripts/Qwen38-Flash-Next-Dual-DSpark.sh. Exported process
# values override these defaults for one invocation. The raw SGLang API stays
# loopback-only; registry/dspark_proxy.yaml exposes the authenticated endpoint.

# Direct ConnectX-7 RoCE link for spark-4e89 -> Lenovo/totalpass.
HEAD_CX7_IP=192.168.177.10
WORKER_CX7_IP=192.168.177.11
HEAD_CX7_IF=enp1s0f1np1
WORKER_CX7_IF=enp1s0f0np0
HEAD_CX7_IB=rocep1s0f1
WORKER_CX7_IB=rocep1s0f0
WORKER_USER=
WORKER_HOST=totalpass@192.168.177.11
WORKER_SSH=
DIST_PORT=26400

# Raw unauthenticated SGLang is private. The shared ml-compute safety proxy is
# the only listener intended for LAN, Tailscale, or Funnel clients.
HOST_BIND=127.0.0.1
PORT=8888
DSPARK_PROXY_HOST=0.0.0.0
DSPARK_PROXY_PORT=8000
SERVED_MODEL_NAME=Qwen3.8-Flash-Next-NVFP4

# MiaAI-Lab's native 1M YaRN/NVFP4-KV profile, with a slightly lower static
# fraction so the worker retains at least 20 GiB of shared GB10 memory.
MEM_FRACTION_STATIC=0.79
CONTEXT_LENGTH=1048576
QWEN38_EFFECTIVE_CONTEXT_LENGTH=1048576
CHUNKED_PREFILL_SIZE=1024
MAX_PREFILL_TOKENS=2048
MAX_RUNNING_REQUESTS=16
ALLOW_AUTO_TRUNCATE=0
ALLOW_SHORT_KV_POOL=0
MAMBA_RADIX_CACHE_STRATEGY=extra_buffer
MAMBA_TRACK_INTERVAL=64
MAMBA_FULL_MEMORY_RATIO=0.3
PLE_OFFLOAD=
EXTRA_ARGS=

# In-checkpoint MTP draft (no second model download).
SPEC_STEPS=3
SPEC_TOPK=1
SPEC_DRAFT=4
ENABLE_DECODE_GRAPHS=1
CUDA_GRAPH_BS=1 2 3 4 5 6 7 8 10 12 14 16

# SM121 kernel/runtime choices. The base multi-arch image and model repository
# are immutable pins resolved when this integration was reviewed.
KERNEL_PATCH=1
BASE_IMAGE=lmsysorg/sglang:qwen38flashnext@sha256:12d3392bdc8be8d35e9a95f191df6aef99c5114bdbefd41bfdc7e760e6d25ec1
PATCHED_IMAGE=qwen38-flashnext-dspark:ml-compute
HF_REVISION=7b719225242aacd3dbd3f9407468c2ee9a9d2594
ATTENTION_BACKEND=flashinfer
NVFP4_KV_CACHE=1
KV_CACHE_DTYPE=
FP4_GEMM_BACKEND=
LINEAR_ATTN_PREFILL_BACKEND=
LINEAR_ATTN_DECODE_BACKEND=

# Operations and caches. HF_HOME defaults to a recipe-specific cache below
# ml-compute/data/dspark when blank, isolating the pinned 135 GB snapshot from
# any moving-main copy managed by the generic local-model downloader.
HF_HOME=
WORKER_HF_HOME=
DOWNLOAD_MODE=rsync
USE_HOST_NCCL=1
WAIT_TIMEOUT_MIN=90
NCCL_DEBUG=WARN
NCCL_CROSS_NIC=0
CPUSET=5-9,15-19
REASONING_PARSER=auto
TOOL_CALL_PARSER=auto

# Cold-start guard for each node's shared CPU/GPU memory pool.
QWEN38_MIN_AVAILABLE_GIB=112
# Post-start guard. A failed reserve check rolls the model launch back.
QWEN38_MIN_RUNTIME_AVAILABLE_GIB=20
