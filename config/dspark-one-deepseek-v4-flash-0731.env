# DeepSeek V4 Flash 0731 on one dedicated DGX Spark.
#
# Consumed by scripts/DS4-Flash-One-DSpark.sh. Exported process values override
# these defaults for one invocation. The raw model API stays loopback-only;
# registry/dspark_proxy.yaml exposes the authenticated endpoint on port 8000.

MODEL_REPO=0xSero/deepseek-v4-flash-0731-spark
MODEL_REVISION=22f28d32b9b29b4352eaa380ff8c2c170b2847ab
SERVED_MODEL_NAME=deepseek-v4-flash-0731

# MiaAI-Lab's validated deep-context TP1 profile.
MAX_MODEL_LEN=384000
MAX_NUM_SEQS=1
MAX_NUM_BATCHED_TOKENS=8224
GPU_MEMORY_UTILIZATION=0.94
KV_RECORD=stock432
MODE=dspark
LONG_PREFILL_TOKEN_THRESHOLD=1024
MAX_NUM_PARTIAL_PREFILLS=0
MAX_CUDAGRAPH_CAPTURE_SIZE=24
CUDAGRAPH_CAPTURE_SIZES=6,12,24
VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS=0
KV_OFFLOAD_GB=0
VERIFY_MODEL_CHECKSUMS=1

# Keep upstream safety behavior and model behavior explicit.
ABLATE=0
DEFAULT_CHAT_TEMPLATE_KWARGS_THINKING=true
DEFAULT_CHAT_TEMPLATE_KWARGS_EFFORT=max

# Security boundary: unauthenticated vLLM is private; the safety proxy is public.
SERVING_HOST=127.0.0.1
SERVING_PORT=8888
DSPARK_PROXY_HOST=0.0.0.0
DSPARK_PROXY_PORT=8000

# Upstream requires at least 114.3 GiB MemAvailable to allocate 94% of UMA.
# This is a dedicated-model profile and is not compatible with a local Harness.
DSPARK_ONE_MIN_AVAILABLE_GIB=114.3
DSPARK_ONE_MIN_DISK_GIB=130
