# DeepSeek V4.1 Flash 1017 TensorFold profile for two linked DGX Sparks.
# Head: northfirst@spark-4e89; worker: totalpass@192.168.177.11.
DSV41_TF_REPO=https://github.com/MiaAI-Lab/DeepSeek-v4.1-Flash-1017-2x-DGX-Sparks.git
DSV41_TF_REF=31eea4608f8bb292a92e2f7a1db400e928620c78

# Immutable model and TensorFold build inputs reviewed with the recipe above.
DSV41_TF_MODEL_ID=Mia-AiLab/DeepSeek-V4.1-Flash-1017-EXL3-EAQ-v1-2.9-bpw
DSV41_TF_MODEL_REVISION=45ee5d0fd106c94a3d77f721e09cbb2f50e5a16b
DSV41_TF_ENGRAM_ID=deepseek-ai/DeepSeek-V4.1-Flash-1017
DSV41_TF_ENGRAM_REVISION=1bae0e1088993b9b82de08f59de5be5a34e42170
DSV41_TF_ENGINE_REPO=https://github.com/bertholomus/TensorFold.git
DSV41_TF_ENGINE_REF=629c524a0ea57512a5342abb498d1b7c25353343
DSV41_TF_INPUTS_REF=59402086381a42c74d53053443224eec2790b4c5
DSV41_TF_KIT_REPO=https://github.com/bertholomus/deepseek-v4.1-tensorfold-tp2-2xgb10.git
DSV41_TF_KIT_REF=abe07c7d509a0199cc7fec15263be2aa52ac652f
DSV41_TF_ZIG_VERSION=0.17.0
DSV41_TF_ZIG_SHA256=9e8d11661d4ae3bd57702a3832781e23ad151dde5798e16a5ccd503f65234ff8
DSV41_TF_BASE_IMAGE=nvcr.io/nvidia/pytorch:26.07-py3@sha256:2140e699b3beaf7f96a0081fd9c9406bc3832b435cdb60dfa2d261f7d2f34a1c
DSV41_TF_IMAGE=tensorfold-dsv41:exl3-tp2-3fd5edeb40cf
DSV41_TF_GHCR_IMAGE=ghcr.io/miaai-lab/deepseek-v4.1-flash-1017-2x-dgx-sparks-tensorfold
DSV41_TF_IMAGE_TAG=
DSV41_TF_IMAGE_DIGEST=
DSV41_TF_CONTAINER=dsv41-1017-exl3-tf

# Direct ConnectX-7 link and SSH control plane.
DSV41_TF_WORKER=totalpass@192.168.177.11
DSV41_TF_FABRIC_PEER=192.168.177.11
DSV41_TF_MASTER_ADDR=192.168.177.10
DSV41_TF_MASTER_PORT=29620

# Raw TensorFold remains private. The authenticated safety proxy owns :8000.
DSV41_TF_SERVED_NAME=DeepSeek-V4.1-Flash-1017
DSV41_TF_HOST=127.0.0.1
DSV41_TF_PORT=8888
DSPARK_PROXY_HOST=0.0.0.0
DSPARK_PROXY_PORT=8000

# The model is native at 1,048,576 tokens. 524,288 is the upstream-tested
# practical ceiling for a head also running a desktop and small services.
DSV41_TF_CONTEXT=524288
DSV41_TF_PARALLEL=4
DSV41_TF_ROUND_ROWS=
DSV41_TF_MAX_TOKENS=32768
DSV41_TF_THINKING=1
DSV41_TF_REASONING_EFFORT=
DSV41_TF_THINKING_BUDGET=
DSV41_TF_TEMPERATURE=1.0
DSV41_TF_TOP_P=0.95
DSV41_TF_TOP_K=20
DSV41_TF_DRAFTS=1
DSV41_TF_RDMA=1
DSV41_TF_GRAPHS=1
DSV41_TF_SIDE=1
DSV41_TF_PREFETCH=1
DSV41_TF_ENGRAM_AIO=1
DSV41_TF_REPLAY_FLOOR=1
DSV41_TF_PREFILL_INTERLEAVE_MS=250

# The head exports this cache read-only to the worker. The first preparation
# needs roughly 505 GB here and 310 GB on the worker.
DSV41_TF_HF_CACHE=/home/northfirst/.cache/huggingface
DSV41_TF_NFS_PATH=/home/northfirst/.cache/huggingface
DSV41_TF_NFS_SERVER=192.168.177.10
DSV41_TF_NFS_VOLUME=dsv41-1017-exl3-hf
DSV41_TF_HEAD_ENGRAM_DIR=
DSV41_TF_HEAD_NFS_SERVER=
DSV41_TF_HEAD_NFS_VOLUME=dsv41-hf-head

# Fail closed before or during a launch rather than freezing either Spark.
DSV41_TF_MIN_AVAIL_GIB=112
DSV41_TF_MIN_AVAIL_WAIT_S=30
DSV41_TF_MEMGUARD_GIB=2.5
DSV41_TF_MEMGUARD_HOLD_S=4
DSV41_TF_MEMGUARD_HARD_GIB=1
DSV41_TF_ABLIT=0
# Build from the pinned sources/base digest. Do not trust an unpinned GHCR tag.
DSV41_TF_PULL=0
DSV41_TF_PREPARE=auto
# Host-side preparation may contact Hugging Face for pinned artifacts. Runtime
# containers remain offline after the download and staging step completes.
DSV41_TF_PREPARE_HF_HUB_OFFLINE=0
DSV41_TF_HF_HUB_OFFLINE=1
