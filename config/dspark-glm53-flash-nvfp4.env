# GLM-5.3 Flash NVFP4 on two linked DGX Sparks (GB10 / SM121).
#
# Consumed by scripts/GLM53-Flash-Dual-DSpark.sh. Exported process values
# override these defaults for one invocation. This is a conservative bring-up
# profile: the checkpoint fits across two Sparks, but its model card does not
# list SM121 as a verified runtime target.

# Direct ConnectX-7 RoCE link. Adjust for the local pair.
HEAD_CX7_IP=192.168.177.10
WORKER_CX7_IP=192.168.177.11
HEAD_CX7_IF=enp1s0f1np1
WORKER_CX7_IF=enp1s0f0np0
HEAD_CX7_IB=rocep1s0f1
WORKER_CX7_IB=rocep1s0f0
WORKER_USER=
WORKER_HOST=totalpass@192.168.177.11
WORKER_SSH=

# Stable Ray cluster/container identities and ports.
RAY_HEAD_PORT=6379
GLM53_HEAD_CONTAINER=glm53-flash-ray-head
GLM53_WORKER_CONTAINER=glm53-flash-ray-worker

# Raw vLLM is private. The shared authenticated safety proxy is public.
HOST_BIND=127.0.0.1
PORT=8888
DSPARK_PROXY_HOST=0.0.0.0
DSPARK_PROXY_PORT=8000

# Immutable model, publisher base image, and Ray-enabled local runtime pins.
MODEL_ID=LibertAIDAI/GLM-5.3-Flash-NVFP4
MODEL_REVISION=11d73216cd636238e82e1d77fe1042ffab36e7fa
SERVED_MODEL_NAME=GLM-5.3-Flash-NVFP4
VLLM_BASE_IMAGE=vllm/vllm-openai:glm53-flash-arm64-cu130@sha256:905c02933be6021301db2dc284e24e3727467aa3a0f63b41d609885778a07bce
VLLM_IMAGE=ml-compute/glm53-flash-ray:ray-2.55.1
RAY_VERSION=2.55.1

# Conservative GB10/SM121 launch profile. The model is natively 1M context,
# but ~181 GiB of weights leave limited UMA for KV/workspaces across two nodes.
TENSOR_PARALLEL_SIZE=2
MAX_MODEL_LEN=32768
MAX_NUM_SEQS=1
MAX_NUM_BATCHED_TOKENS=4096
GPU_MEMORY_UTILIZATION=0.84
KV_CACHE_DTYPE=auto

# The model card recommends this fallback when native FP4 MoE kernels lack an
# SM121 image. Eager mode also avoids CUDA-graph memory during initial bring-up.
MOE_BACKEND=marlin
ENFORCE_EAGER=1

# Model-native tool/reasoning parsers and in-checkpoint MTP layer.
TOOL_CALL_PARSER=glm47
REASONING_PARSER=glm45
MTP_SPECULATIVE_TOKENS=5

# Operations and caches. Blank paths are resolved below ignored
# data/dspark/glm53-flash/ on the head and ~/.cache/huggingface on the worker.
HF_HOME=
WORKER_HF_HOME=
DOWNLOAD_MODE=rsync
VLLM_ENGINE_READY_TIMEOUT_S=3600
CPUSET=5-9,15-19
NCCL_DEBUG=WARN
NCCL_CROSS_NIC=0

# Cold-start guards for each unified-memory node and the 181 GiB checkpoint.
GLM53_MIN_AVAILABLE_GIB=112
GLM53_MIN_DISK_GIB=240
