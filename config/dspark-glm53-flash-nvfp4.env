# GLM-5.3 Flash EXL3 + DFlash2 on two linked DGX Sparks (GB10 / SM121).
#
# The legacy filename is intentionally retained so existing ml-compute CLI,
# automation, and deployment references keep working. The serving backend is
# now MiaAI-Lab's validated EXL3/MP recipe rather than the former NVFP4/Ray one.
# Exported process values override these defaults for one invocation.

# Direct ConnectX-7 RoCE link. IPs select the link; interface/HCA names are
# compatibility hints and are auto-detected from those IPs on each node.
HEAD_CX7_IP=192.168.177.10
WORKER_CX7_IP=192.168.177.11
HEAD_CX7_IF=enp1s0f1np1
WORKER_CX7_IF=enp1s0f1np1
HEAD_CX7_IB=rocep1s0f1
WORKER_CX7_IB=rocep1s0f1
WORKER_USER=totalpass
WORKER_HOST=192.168.177.11
WORKER_SSH=
MASTER_PORT=29521

# Stable ml-compute container identities and ports.
GLM53_HEAD_CONTAINER=glm53-flash-head
GLM53_WORKER_CONTAINER=glm53-flash-worker

# Raw vLLM is private. The shared authenticated safety proxy is public.
HOST_BIND=127.0.0.1
PORT=8888
DSPARK_PROXY_HOST=0.0.0.0
DSPARK_PROXY_PORT=8000

# Immutable target, optional draft, and OCI image pins from the measured MiaAI
# run. VLLM_SOURCE_IMAGE is pulled by digest then tagged locally as VLLM_IMAGE.
MODEL_ID=brandonmusic/GLM-5.3-Flash-tr3-4bpw
MODEL_REVISION=5ab363a8dcf6405955fd5f99671e01a1c9fb124b
DFLASH_MODEL_ID=incoai/GLM-5.3-Flash-DFlash2
DFLASH_MODEL_REVISION=dc77ff1c99eeb2df044ee3d4f0094eb033fee410
SERVED_MODEL_NAME=GLM-5.3-Flash-EXL3
VLLM_BASE_IMAGE=vllm/vllm-openai:glm53-flash-arm64-cu130@sha256:905c02933be6021301db2dc284e24e3727467aa3a0f63b41d609885778a07bce
VLLM_SOURCE_IMAGE=ghcr.io/miaai-lab/glm-5.3-flash-2x-dgx-sparks@sha256:447114ee77d14c9b4732ee23978ada2a0ee9027868a231d6fd42700a8b25be1d
VLLM_IMAGE=ml-compute/glm53-flash-exl3:mp-dflash2-v6-56d0bdf
# Direct-I/O safetensors path baked into MiaAI's current published image.
LOAD_FORMAT=instanttensor

# MiaAI-Lab's measured GB10/SM121 launch profile. vLLM multiprocessing joins
# one rank per Spark directly; no Ray object store is involved.
TENSOR_PARALLEL_SIZE=2
NUM_NODES=2
DISTRIBUTED_EXECUTOR_BACKEND=mp
QUANTIZATION=exl3
MAX_MODEL_LEN=850000
MAX_NUM_SEQS=4
# E3 groups every fat expert into three GPU-driven launches. Mia measured
# 37-45% faster cold prefill over E2 at this 7168-token chunk size.
MAX_NUM_BATCHED_TOKENS=7168
# The lower E3 UMA budget leaves about 2.4 GiB more host headroom than 0.87.
GPU_MEMORY_UTILIZATION=0.85
KV_CACHE_DTYPE=fp8
ENFORCE_EAGER=0
EXL3_FUSED_MOE=1
EXL3_FAT_SORTED=0
EXL3_FAT_BATCHED=0
EXL3_FAT_KERNEL=1
EXL3_FAT_GROUPED=1
EXL3_TEMP_ROWS_FUSED=32
ENABLE_PREFIX_CACHING=1

# DFlash2 is the measured default. Its model is CC BY-NC-ND 4.0; commercial
# deployments without separate permission should set SPEC_METHOD=mtp. In that
# mode the lifecycle neither downloads nor mounts the DFlash2 checkpoint.
SPEC_METHOD=dflash
DFLASH_SPECULATIVE_TOKENS=7
# Shard the 2.3 GiB draft across both ranks. MiaAI measured a structured decode
# gain from 61.7 to 65.1 tok/s while prose held within noise.
DFLASH_DRAFT_TP=2
MTP_SPECULATIVE_TOKENS=2

# Model-native tool/reasoning parsers and multimodal guardrails.
TOOL_CALL_PARSER=glm47
REASONING_PARSER=glm45
LANGUAGE_MODEL_ONLY=0
LIMIT_MM={"image":48,"video":1}
MM_IMAGE_TOKENS=2048
VIDEO_NUM_FRAMES=
MM_PROCESSOR_CACHE_GB=1
SKIP_MM_PROFILING=1
TORCH_CUDA_ARCH_LIST=12.1a
FLASHINFER_CUDA_ARCH_LIST=12.1a

# Operations and caches. Blank paths resolve below ignored
# data/dspark/glm53-flash/ on the head and ~/.cache on the worker.
HF_HOME=
WORKER_HF_HOME=
DOWNLOAD_MODE=rsync
VLLM_ENGINE_READY_TIMEOUT_S=3600
CACHE_ROOT=
WORKER_VLLM_CACHE=

# Persist JIT products, compile common TP=2 shapes before serving clients, keep
# active decode fairly interleaved with peer prefills, and prevent harness stop
# strings from truncating output while GLM is still inside <think>.
GLM53_SUPPRESS_STOPS_IN_REASONING=1
DEFAULT_MAX_NEW_TOKENS=65536
GLM53_MIXED_PREFILL_CHUNK=fair
GLM53_FAIR_PREFILL_CHUNK=256
GLM53_FAIR_PREFILL_SHARE=0.30
GLM53_FAIR_PREFILL_MAX_INTERVAL_MS=2000
GLM53_FAIR_PREFILL_MAX_STEP_MS=2000
GLM53_FAIR_PREFILL_MAX_CHUNKS=1
GLM53_APC_NO_STORE=1
GLM53_KV_CAPACITY_LOG=1
# Current memory/performance-safe upstream defaults. Adaptive verification can
# be qualified later; dense FP8 changes target numerics and stays disabled.
GLM53_INDEXER_WORKSPACE=rightsize
GLM53_SPINWAIT_MS=stock
LONG_PREFILL_TOKEN_THRESHOLD=
GLM53_DEFAULT_REASONING_EFFORT=
GLM53_ADAPTIVE_K=off
GLM53_DENSE_FP8=off
# Cooperative MoE remains an upstream opt-in generated overlay. It is not
# enabled by the reviewed stock profile; use a separately qualified A/B profile.
GLM53_COOP_GEOMETRY=
GLM53_APC_RETENTION_INTERVAL=
GLM53_APC_RETENTION_INTERVAL_SWA=
VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS=1800
GLM53_BOOT_SHAPE_WARMUP=1
GLM53_WARMUP_REQ_TIMEOUT=240
# The v1.6 image profiles a 2.43 GiB CUDA-graph reservation although its
# captured graphs consume about 0.19 GiB here. Retaining that deduction leaves
# only ~11 GiB KV and cannot admit the 850K profile; 0 keeps CUDA graphs on
# while returning the conservative reservation to the KV pool.
CG_ESTIMATE=0

# Keep the reviewed stock EXL3 weights. MiaAI's optional refusal-direction
# ablation changes model behavior and is deliberately outside this recipe.
ABLIT=0

# The MiaAI image already includes its compatible NCCL. Preloading a second
# host copy can make DeepEP detect duplicate NCCL libraries and abort.
USE_HOST_NCCL=0
NCCL_HOST_DIR=
WORKER_NCCL_HOST_DIR=
NCCL_SO_NAME=libnccl.so.2.30.7
NCCL_DEBUG=WARN
NCCL_NCHANNELS=
NCCL_IB_GID_INDEX=3
# Optional per-rank overrides. Leave blank when the same RoCEv2 GID index is
# populated on both HCAs; otherwise set each node's own RoCE v2 entry.
HEAD_GID=
WORKER_GID=
NCCL_CROSS_NIC=0
EXTRA_ARGS=

# Cold-start guards for each unified-memory node and the ~164 GiB target.
GLM53_MIN_AVAILABLE_GIB=111
GLM53_MIN_DISK_GIB=220
