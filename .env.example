# API key clients use to call this server (Authorization: Bearer ...)
# Generate one with: ml-compute config gen-key
API_KEY=

# HuggingFace token (only needed for gated models like Llama, Gemma).
# Leave the line OFF entirely if you don't have one — an empty value
# breaks the http auth header. Either set a real token or delete this line.
# HF_TOKEN=hf_xxxxx

# vLLM bind address
VLLM_HOST=0.0.0.0
VLLM_PORT=8000

# Storage paths (override if you have a persistent volume)
DATA_DIR=./data
REGISTRY_DIR=./registry
HF_HOME=./data/hf_cache
