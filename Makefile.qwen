# Qwen3.5-4B QLoRA fine-tuning on RTX PRO 4500 Blackwell.
#
# REQUIRED parameter:
#   DATASET=<path to .jsonl>     input dataset with {messages: [user, assistant]}
#
# OPTIONAL parameters (with defaults):
#   ADAPTER_NAME=<name>          output adapter name (default: qwen3.5-4b-001)
#   MAX_SEQ_LEN=<int>            token cap per sample (default: 8192)
#   EPOCHS=<int>                 training epochs (default: 3)
#   RANK=<int>                   LoRA rank (default: 16)
#   LR=<float>                   learning rate (default: 2e-4)
#   BATCH_SIZE=<int>             micro-batch (default: 4)
#   GRAD_ACCUM=<int>             gradient accumulation steps (default: 4)
#
# Pipeline:
#   make -f Makefile.qwen report  DATASET=path/to/seed.jsonl    # tokenize-and-report
#   make -f Makefile.qwen filter  DATASET=path/to/seed.jsonl    # apply token cap
#   make -f Makefile.qwen smoke   DATASET=path/to/seed.jsonl    # 5-record smoke test
#   make -f Makefile.qwen train   DATASET=path/to/seed.jsonl ADAPTER_NAME=my-ft-001
#   make -f Makefile.qwen all     DATASET=path/to/seed.jsonl ADAPTER_NAME=my-ft-001
#
# Expected wall time on RTX PRO 4500, 400-500 samples × 3 epochs, max_seq_len=8192:
#   ~30-50 minutes.

DATASET      ?=
ADAPTER_NAME ?= qwen3.5-4b-001
BASE_MODEL   ?= Qwen/Qwen3.5-4B
MAX_SEQ_LEN  ?= 8192
EPOCHS       ?= 3
RANK         ?= 16
LR           ?= 2e-4
BATCH_SIZE   ?= 4
GRAD_ACCUM   ?= 4
SAVE_EVERY   ?= 30    # ~1 checkpoint per epoch for ~80-step runs

# Derived: place the filtered output next to the input with a `_train` suffix.
TRAIN_SET    := $(basename $(DATASET))_train.jsonl
ADAPTER_DIR  := data/adapters/$(ADAPTER_NAME)

.PHONY: check report filter smoke train serve all _require_dataset

_require_dataset:
	@test -n "$(DATASET)" || (echo "ERROR: pass DATASET=<path-to-jsonl>" && exit 1)

check: _require_dataset
	@echo "== Pre-flight =="
	@test -f $(DATASET) || (echo "Missing dataset at $(DATASET)" && exit 1)
	@echo "✓ dataset:     $(DATASET)"
	@echo "✓ adapter:     $(ADAPTER_NAME)"
	@echo "✓ max_seq_len: $(MAX_SEQ_LEN)"
	@python3 -c "import torch, transformers, unsloth, trl; \
		print('✓ training deps installed (torch', torch.__version__, ')')"

# Report-only: tokenize and print stats; no file written.
report: check
	@echo "== Tokenization report ($(BASE_MODEL) tokenizer) =="
	python3 -m ml.distill_token_filter \
		--input       $(DATASET) \
		--output      /tmp/discard.jsonl \
		--base        $(BASE_MODEL) \
		--max-tokens  $(MAX_SEQ_LEN) \
		--report-only

filter: check $(TRAIN_SET)

# File rule: produce the filtered training set from the seed dataset.
# This lets `train` and `smoke` auto-trigger `filter` if TRAIN_SET is missing.
$(TRAIN_SET): $(DATASET)
	@echo "== Step 1: token-cap $(DATASET) to $(MAX_SEQ_LEN) tokens =="
	python3 -m ml.distill_token_filter \
		--input       $(DATASET) \
		--output      $(TRAIN_SET) \
		--base        $(BASE_MODEL) \
		--max-tokens  $(MAX_SEQ_LEN)

# Smoke test: 5 records, 1 epoch — should finish in ~2 min.
smoke: $(TRAIN_SET)
	@echo "== Smoke test (5 records, 1 epoch) =="
	python3 -m ml.distill_train_unsloth \
		--dataset      $(TRAIN_SET) \
		--adapter-name $(ADAPTER_NAME)-smoke \
		--base         $(BASE_MODEL) \
		--epochs       1 \
		--limit        5 \
		--rank         $(RANK) \
		--lr           $(LR) \
		--max-seq-len  $(MAX_SEQ_LEN) \
		--batch-size   1 \
		--grad-accum   1

train: $(TRAIN_SET)
	@echo "== QLoRA fine-tune $(BASE_MODEL) =="
	@echo "  Adapter:       $(ADAPTER_NAME)"
	@echo "  Train set:     $(TRAIN_SET)"
	@echo "  max_seq_len:   $(MAX_SEQ_LEN)"
	@echo "  epochs:        $(EPOCHS)"
	@echo "  rank:          $(RANK)"
	@echo "  lr:            $(LR)"
	@echo "  bs × accum:    $(BATCH_SIZE) × $(GRAD_ACCUM)"
	@echo ""
	@echo "  Stop the inference server first to free VRAM:"
	@echo "    python3 -m ml.cli stop"
	@read -p "  Press Enter to start training (Ctrl+C to abort)..." _
	python3 -m ml.distill_train_unsloth \
		--dataset      $(TRAIN_SET) \
		--adapter-name $(ADAPTER_NAME) \
		--base         $(BASE_MODEL) \
		--epochs       $(EPOCHS) \
		--rank         $(RANK) \
		--lr           $(LR) \
		--max-seq-len  $(MAX_SEQ_LEN) \
		--batch-size   $(BATCH_SIZE) \
		--grad-accum   $(GRAD_ACCUM) \
		--save-every   $(SAVE_EVERY)

serve:
	@echo "== Serve base $(BASE_MODEL) with adapter $(ADAPTER_NAME) =="
	@echo "  Add an entry to registry/models.yaml with:"
	@echo "    loras:"
	@echo "      - name: $(ADAPTER_NAME)"
	@echo "        path: $(ADAPTER_DIR)"
	@echo "        rank: $(RANK)"
	@echo "  Then: python3 -m ml.cli serve <alias>"

all: filter train
